<svg xmlns="http://www.w3.org/2000/svg"
     width="{{ .Width }}"
     height="20"
     role="img"
     aria-label="{{ .Version }}">
  <title>{{ .Version }}</title>

  <rect width="{{ .Width }}"
        height="20"
        rx="3"
        fill="{{ .Color }}"/>

  <text x="{{ .Center }}"
        y="14"
        fill="#fff"
        text-anchor="middle"
        font-family="Verdana, Geneva, DejaVu Sans, sans-serif"
        font-size="11">
    {{ .Version }}
  </text>
</svg>
